# === DATABASE ===
# Development (SQLite):
#   DATABASE_URL="file:./dev.db"
# Production (PostgreSQL via Docker):
DATABASE_URL="postgresql://wwf:CHANGE_ME@localhost:5432/wwf_crotone?schema=public"

# === AUTHENTICATION ===
# Required in every environment — generate with: openssl rand -base64 48
# The app refuses to boot if this is missing, is the placeholder, or
# contains "change-me". Generate a fresh one for each environment.
AUTH_SECRET="change-me-with-openssl-rand-base64-48"

# === SITE CONFIG ===
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# === TRANSACTIONAL EMAIL (Brevo SMTP) ===
# As of 2026 the site sends transactional mail (booking confirmations,
# magic links, admin notifications, bulk sends) through Brevo's SMTP
# relay. The free tier gives 300 emails/day, which covers the camp's
# peak registration window comfortably.
#
# Setup:
#   1. Create a Brevo account at https://www.brevo.com
#   2. Dashboard → Settings → SMTP & API → generate an SMTP key
#      (NOT your account password — Brevo uses a separate SMTP key).
#   3. Verify the sender domain or single address you'll use in `from`.
#
# Note: the public-facing inbox `wwfcrotone26@gmail.com` is unaffected
# — it's a destination only, routed in via Cloudflare Email Routing
# from `info@wwfcrotone.it`. It is NOT the SMTP sender anymore.
#
# Fallback: if Brevo's daily quota is exceeded, flip USE_BREVO_EMAIL=false
# and reconfigure SMTP_HOST/SMTP_USER/SMTP_PASS below to fall back to
# Gmail SMTP (Gmail App Password from myaccount.google.com/apppasswords).
USE_BREVO_EMAIL="true"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
# Brevo SMTP key (NOT your Brevo account password)
SMTP_PASS=""

# === ANALYTICS (optional) ===
# Plausible domain — leave empty to disable
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# === INSTAGRAM (optional) ===
# Instagram Graph API token
INSTAGRAM_TOKEN=""

# === SENTRY (optional) ===
# Server-side DSN (from Sentry → Project → Settings → Client Keys → DSN).
# Leave empty to disable Sentry entirely (the SDK becomes a no-op).
# WWF Crotone project lives in the EU region (de.sentry.io).
# Get the value from Sentry → Project → Settings → Client Keys (DSN).
SENTRY_DSN=""
# Same DSN, exposed to the browser. NEXT_PUBLIC_* vars are visible in
# the shipped JS bundle — that's fine for Sentry, the DSN is meant to
# be public. If unset, the client config falls back to SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=""
# Sentry org + project slugs for source-map upload. Defaults to
# wwf-provincia-di-crotone-ets / javascript-nextjs (set up 2025-08).
SENTRY_ORG="wwf-provincia-di-crotone-ets"
SENTRY_PROJECT="javascript-nextjs"
# Auth token for source-map upload. Required in CI; never committed.
# Create at https://wwf-provincia-di-crotone-ets.sentry.io/settings/auth-tokens/
# (scope: project:releases). When unset, the build uploads NO source
# maps (silent skip).
SENTRY_AUTH_TOKEN=""

# === STATUS PAGE ===
# UptimeRobot API key (Bearer token, from UptimeRobot → My Settings →
# API Settings). Without this, the cron worker still runs but won't
# pull monitor data — only self-probes + statuspage feeds will be live.
# Required for the status page to be useful.
UPTIMEROBOT_API_KEY=""

# The URL the cron worker probes to know if the app itself is up.
# Default is fine for docker-compose (the cron container can reach the
# app container by service name). Override for k8s / non-default setups.
# SELF_HEALTH_URL="http://app:3000/api/health"

# === PAYMENTS (M6) ===
# Stripe — leave empty to disable online payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Bank transfer / cash are always available and require no config

# === AI CHAT ASSISTANT ===
# Groq API key (free tier, no card required): https://console.groq.com/keys
# Model: llama-3.3-70b-versatile. Leave empty to disable the chat widget.
GROQ_API_KEY=""

# === RATE LIMITING (C-01) ===
# Upstash Redis REST credentials (https://upstash.com). When both are
# set, the rate limiter stores its counters in Upstash (persistent across
# restarts and shared between instances). When unset, falls back to an
# in-memory token bucket — fine for single-process dev, NOT for prod.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# === TRUSTED PROXY HEADER (C-02) ===
# Header name (lowercase) carrying the real client IP from your reverse
# proxy. In production the rate limiter ignores `x-forwarded-for` because
# clients can forge it. Common values: "cf-connecting-ip" (Cloudflare),
# "x-real-ip" (nginx). Leave unset in dev.
# TRUSTED_PROXY_HEADER=""

# === LOOKUP ADMIN TOKEN (C-03) ===
# Optional. When set, requests to /api/iscrizione/lookup that carry this
# token in the `x-admin-token` header receive a full PII-level lookup
# for staff scripts. When unset, only the volunteer's HMAC-signed cookie
# can authenticate the request.
# LOOKUP_ADMIN_TOKEN=""

# === STATUS PAGE === (see above — moved next to Sentry section)
# UPTIMEROBOT_API_KEY=""
# SELF_HEALTH_URL="http://app:3000/api/health"
