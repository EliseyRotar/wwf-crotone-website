generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin / manager accounts. Role superadmin = you (creator), sees everything.
// Role manager = Paolo or other local WWF managers, limited to their assigned turns.
model User {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String?
  passwordHash      String
  role              String       @default("manager") // "superadmin" | "manager"
  assignedTurns     String? // CSV of Turno.id for managers, null = all turns (superadmin)
  expiresAt         DateTime? // when the account expires (e.g. when the last assigned turn ends)
  active            Boolean      @default(true) // false = disabled
  totpSecret        String? // M4: TOTP secret for 2FA
  totpEnabled       Boolean      @default(false) // M4: 2FA enabled flag
  deletedAt         DateTime? // M1: soft delete timestamp
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  iscrizioniManaged Iscrizione[] @relation("ManagedBy")
  receiptsApproved ReceiptUpload[] @relation("ReceiptApprovedBy")
}

// Weekly camp turns. The 12 turns for summer 2026 are seeded.
// capacity is the max volunteers per turn (configurable from admin).
model Turno {
  id              String            @id @default(cuid())
  number          Int               @unique // 1..12
  startDate       DateTime
  endDate         DateTime
  capacity        Int               @default(20)
  bookedCount     Int               @default(0) // C-07: atomic counter for capacity
  isActive        Boolean           @default(true)
  iscrizioni      Iscrizione[]
  iscrizioneTurni IscrizioneTurno[] // M5: junction for multi-week registrations
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([number])
}

// A registration. status is managed from admin panel.
// isMinor triggers the parent/guardian consent block.
model Iscrizione {
  id                       String            @id @default(cuid())
  // Personal
  firstName                String
  lastName                 String
  birthDate                DateTime? // null when only age is known (imported from Excel)
  age                      Int? // used when birthDate is unknown; admin can add birthDate later
  email                    String
  phone                    String
  isMinor                  Boolean
  // If minor
  guardianName             String?
  guardianEmail            String?
  guardianPhone            String?
  guardianConsent          Boolean           @default(false)
  // Turn — primary turn; multi-week registrations use the IscrizioneTurno junction
  turnoId                  String
  turno                    Turno             @relation(fields: [turnoId], references: [id])
  iscrizioneTurni          IscrizioneTurno[] // M5: junction for multi-week registrations
  // Health & diet
  allergies                String?
  medications              String?
  swimmingAbility          String? // "none" | "basic" | "confident"
  tetanusStatus            String? // "unknown" | "vaccinated" | "not_vaccinated"
  fitnessSelf              String?
  dietaryNeeds             String? // "none" | "vegetarian" | "vegan" | "celiac" | "other"
  dietaryNotes             String?
  tshirtSize               String? // "S" | "M" | "L" | "XL" | "XXL"
  // Logistics
  arrivalMode              String? // "own_car" | "train" | "bus" | "plane_crotone" | "plane_lamezia" | "ferry" | "taxi" | "rental_car" | "need_pickup" | "other"
  arrivalFrom              String? // free-text "from where" — city, line, terminal, etc.
  flightNumber             String? // for plane_crotone / plane_lamezia
  trainNumber              String? // for train
  busCompany               String? // for bus / ferry
  arrivalNotes             String? // free-text details for the organisers (max 500)
  arrivalTime              String? // e.g. "14:30"
  departureTime            String? // e.g. "10:00"
  // Admin-managed
  // Lifecycle (Phase 2 — full user flow with email + receipt + confirmation):
  //   pending           → just submitted, awaiting email verification
  //   email_verified    → user clicked the magic link
  //   receipt_uploaded  → user uploaded the bonifico (deposit or balance)
  //   confirmed         → admin approved and registration is locked
  //   cancelled         → cancelled (by user or admin)
  //   waitlist          → full turn, on waitlist
  status                   String            @default("pending")
  // Phase 2 timestamps — one per status transition for audit + notifications
  emailVerifiedAt          DateTime?
  receiptUploadedAt        DateTime?
  confirmedAt              DateTime?
  cancelledAt              DateTime?
  // Phase 2: optional password (magic-link is the default; user can set a
  // password in their panel if they want). Null = magic-link only.
  passwordHash             String?
  passwordSetAt            DateTime?
  // Payment tracking — split into registration fee (100€) + balance
  feePaid                  Boolean           @default(false) // 100€ registration fee paid
  feePaidDate              DateTime?
  balancePaid              Boolean           @default(false) // remaining balance paid
  balancePaidDate          DateTime?
  paymentIntentId          String? // M6: external payment intent reference (e.g. Stripe)
  notes                    String? // internal admin notes (length validated at app level)
  // Phase 2: receipt tracking — set on volunteer self-service upload,
  // approved by admin from /admin/iscrizioni.
  depositReceiptUrl        String?
  balanceReceiptUrl        String?
  depositReceiptUploadedAt DateTime?
  balanceReceiptUploadedAt DateTime?
  depositReceiptApprovedAt DateTime?
  balanceReceiptApprovedAt DateTime?
  // Consent
  privacyConsent           Boolean           @default(false)
  marketingConsent         Boolean           @default(false)
  imageDataConsent         Boolean           @default(false)
  // Meta
  deletedAt                DateTime? // M1: soft delete timestamp
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  managedBy                String? // User.id who last changed status
  manager                  User?             @relation("ManagedBy", fields: [managedBy], references: [id])
  receipts                 Receipt[]
  payments                 Payment[] // M6: payment history
  // Personal-user area (Phase 1): when set, the volunteer cannot edit their
  // personal/contact fields via /account/profile. Logistics fields remain
  // editable until the camp starts.
  personalDataLockedAt     DateTime?
  // Phase 2: editable-until-the-camp-starts lock for the user's personal
  // panel. We compute this as (turno.startDate - 7 days) the first time the
  // user visits their panel after that date, and freeze all their edits.
  // Admins can still edit through /admin/iscrizioni.
  editsLockedAt            DateTime?

  // Phase 2 back-relations
  verificationTokens      IscrizioneVerificationToken[]
  receiptUploads          ReceiptUpload[]

  @@index([turnoId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([turnoId, status])
  @@index([managedBy])
}

// Phase 2: single-use email verification tokens. The user clicks the magic
// link in their confirmation email, we hash the inbound token, find a row
// with the matching tokenHash, mark it consumed, and advance the
// Iscrizione.status from "pending" to "email_verified".
//
// We use a separate table (rather than reusing the existing MagicLinkToken)
// because the user flow here is different: registration confirmation is
// per-Iscrizione (not per-email), and we want a tighter expiry (24h) and
// richer metadata (which status transition does this token authorize).
model IscrizioneVerificationToken {
  id           String     @id @default(cuid())
  iscrizioneId String
  iscrizione   Iscrizione @relation(fields: [iscrizioneId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the raw token, base64url-encoded. The raw token is
  // only ever delivered by email and never persisted.
  tokenHash    String     @unique
  // What status this token authorizes when consumed. Default = the next
  // status in the lifecycle ("pending" → "email_verified"). Used by the
  // redeem route to know what to set on the Iscrizione.
  authorizesStatus String  @default("email_verified")
  // 24-hour expiry. Slightly longer than the magic-link for /account login
  // because the user has to find the email, click, then upload a receipt.
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([iscrizioneId])
  @@index([expiresAt])
}

// Phase 2: receipt file uploads. Each row is one uploaded file (a photo or
// PDF of the bonifico), stored on Cloudflare R2 in the wwf-receipts bucket.
// Type can be "deposit" (the 100€ registration fee) or "balance" (the
// remainder of the camp fee paid later).
model ReceiptUpload {
  id           String     @id @default(cuid())
  iscrizioneId String
  iscrizione   Iscrizione @relation(fields: [iscrizioneId], references: [id], onDelete: Cascade)
  // "deposit" | "balance"
  type         String
  // R2 object key: receipts/<iscrizioneId>/<type>-<timestamp>-<random>.<ext>
  objectKey    String
  // Public-facing URL for the admin to view/download the receipt.
  // Goes through a /api/admin/iscrizioni/[id]/receipt proxy that checks
  // session auth, so we don't expose R2 credentials.
  url          String
  // File metadata
  originalName String
  mimeType     String
  byteSize     Int
  // SHA-256 of the file body for integrity verification.
  sha256       String
  // Admin workflow
  approvedAt   DateTime?
  approvedBy   String?
  approver     User?     @relation("ReceiptApprovedBy", fields: [approvedBy], references: [id])
  rejectionReason String?
  createdAt    DateTime  @default(now())

  @@index([iscrizioneId])
  @@index([type])
  @@index([approvedAt])
}

// M5: Junction table for multi-week registrations.
// isPrimary flags the main turn on the Iscrizione row.
model IscrizioneTurno {
  id           String     @id @default(cuid())
  iscrizioneId String
  iscrizione   Iscrizione @relation(fields: [iscrizioneId], references: [id], onDelete: Cascade)
  turnoId      String
  turno        Turno      @relation(fields: [turnoId], references: [id])
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([iscrizioneId, turnoId])
  @@index([turnoId])
}

model GalleryItem {
  id         String    @id @default(cuid())
  type       String // "image" | "video"
  src        String // path or youtube id
  thumbnail  String? // for video, poster
  titleIt    String
  titleEn    String?
  captionIt  String?
  captionEn  String?
  category   String // "tartarughe" | "cleanup" | "wildlife" | "campo" | "schiuse" | "cultura"
  year       Int       @default(2026)
  uploaderId String? // User.id
  deletedAt  DateTime? // M1: soft delete timestamp
  createdAt  DateTime  @default(now())

  @@index([category])
  @@index([year])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("it")
  consent        Boolean   @default(false)
  consentedAt    DateTime?
  consentIp      String?
  consentUa      String?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Camp operators / staff (distinct from volunteer registrations).
// role: "operatore" | "tecnico" | "coordinatore"
model Operatore {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  sex           String? // "M" | "F"
  role          String    @default("operatore") // "operatore" | "tecnico" | "coordinatore"
  email         String?
  phone         String?
  // CSV of Turno.id — which turns the operator is assigned to
  assignedTurns String?
  notes         String?
  deletedAt     DateTime? // M1: soft delete timestamp
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([role])
}

// M3: In-progress draft registrations saved between wizard steps.
model DraftIscrizione {
  id        String   @id @default(cuid())
  email     String
  data      String // JSON blob
  step      Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
}

// Receipt/bonifico uploaded by the volunteer
model Receipt {
  id           String     @id @default(cuid())
  iscrizioneId String
  iscrizione   Iscrizione @relation(fields: [iscrizioneId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  mimeType     String
  uploadedAt   DateTime   @default(now())

  @@index([iscrizioneId])
}

// M6: Payment history. One Iscrizione can have multiple Payments
// (deposit + balance + future Stripe intents).
model Payment {
  id           String     @id @default(cuid())
  iscrizioneId String
  iscrizione   Iscrizione @relation(fields: [iscrizioneId], references: [id], onDelete: Cascade)
  amountCents  Int
  currency     String     @default("EUR")
  provider     String // "stripe" | "bank_transfer" | "cash"
  status       String     @default("pending") // "pending" | "completed" | "failed" | "refunded"
  externalId   String? // Stripe payment intent id
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([iscrizioneId])
  @@index([status])
}

// Blog / news posts
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleIt     String
  titleEn     String?
  contentIt   String
  contentEn   String?
  excerptIt   String?
  excerptEn   String?
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  deletedAt   DateTime? // M1: soft delete timestamp
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([published])
  @@index([published, publishedAt])
}

// Audit log for admin actions
// Phase 1: extended to support per-field changes — `fieldName`, `oldValue`,
// `newValue`, plus request context (ipAddress, userAgent). Older rows
// without these columns are still valid (the columns are nullable).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // "create" | "update" | "delete" | "status_change" | "payment" | "login" | "field_change"
  entity    String // "iscrizione" | "turno" | "operatore" | "user" | "gallery" | "blog" | "settings"
  entityId  String?
  details   String? // JSON or human-readable description
  fieldName String? // Phase 1: which field changed (for per-field audit)
  oldValue  String? // Phase 1: previous value (stringified; null = was null)
  newValue  String? // Phase 1: new value (stringified; null = became null)
  ipAddress String? // Phase 1: caller IP (truncated)
  userAgent String? // Phase 1: caller UA (truncated to 256 chars at write)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@index([entityId])
}

// Camp settings — year, dates, number of turns (for recurring camp config)
model CampSettings {
  id               String   @id @default(cuid())
  year             Int      @default(2026)
  startDate        DateTime
  endDate          DateTime
  numTurns         Int      @default(12)
  turnDurationDays Int      @default(7)
  costNonMember    Int      @default(430)
  costMember       Int      @default(400)
  minorInsurance   Int      @default(20)
  registrationFee  Int      @default(100)
  iban             String   @default("IT30V0306909606100000107334")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
}

// Phase 1: one-time magic links emailed to volunteers for passwordless login
// to /account. We store only the SHA-256 hash of the token (not the token
// itself) so a DB leak does not let the attacker log in as any user. Tokens
// are single-use (consumedAt) and expire in 30 minutes.
model MagicLink {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

// Phase 1: "remember this device" cookie. We persist a row per (user,
// device) so we can revoke a device, list active devices, and audit the
// last-seen IP/UA. The cookie itself is an HMAC-signed payload bound to
// the row's deviceHash + expiresAt — see src/lib/deviceSession.ts.
model DeviceSession {
  id         String   @id @default(cuid())
  userId     String // Iscrizione.id of the volunteer this device is logged in as
  deviceHash String // HMAC of UA + accept-language + a server secret
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@unique([userId, deviceHash])
  @@index([expiresAt])
}

// Phase 2: lightweight admin notifications (e.g. "volunteer X uploaded a
// receipt", "volunteer Y edited their booking"). Linked to admin User.id
// — not the volunteer's Iscrizione.id — so the admin bell can list
// pending items per admin. The admin panel can mark them read (readAt).
model Notification {
  id        String    @id @default(cuid())
  userId    String // admin User.id (who should see this)
  type      String // "booking_edit" | "receipt_upload" | ...
  title     String
  body      String
  link      String? // e.g. /admin/iscrizioni/[id]
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// =====================================================================
// Status page models — public-facing status.wwfcrotone.it
// =====================================================================
//
// One StatusService row per thing we monitor (24 today, includes both our
// own infra and external providers). Data is collected by scripts/status-poll.js
// every 60s, persisted to StatusSnapshot (raw 60s samples, 7-day TTL) and
// StatusPeriod (event log of status changes — grows slowly, used for 30-day
// uptime math). Incidents are stored locally even when the source is external
// (e.g. a Cloudflare statuspage incident is mirrored as Incident.source =
// "statuspage-feed" so it shows up in our search/sitemap without depending on
// our caching of their page).

// Catalogue of monitored services. Populated by prisma/seed-status.ts.
model StatusService {
  id             String   @id @default(cuid())
  slug           String   @unique // "main-site", "postgres", "cloudflare-dns"
  name_it        String // "Sito principale"
  name_en        String // "Main site"
  category       String // "user-facing" | "infrastructure" | "external"
  display_order  Int      @default(0)
  source         String // "uptimerobot" | "statuspage" | "self-probe" | "instatus"
  source_id      String? // UptimeRobot monitor id OR statuspage subdomain
  url            String? // human-facing URL (shown in UI + clickable)
  icon           String? // optional lucide icon name
  description_it String?
  description_en String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  snapshots StatusSnapshot[]
  periods   StatusPeriod[]
  incidents Incident[]

  @@index([category, display_order])
  @@index([source, source_id])
}

// Raw 60s samples. Heavy: pruned to last 7 days by a nightly job.
// Powers the 24h uptime chart and instant status.
model StatusSnapshot {
  id          BigInt        @id @default(autoincrement())
  service_id  String
  status      String // "up" | "down" | "degraded" | "unknown"
  response_ms Int?
  taken_at    DateTime      @default(now())
  service     StatusService @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id, taken_at])
}

// Event log: one row per status change. Powers 7d/30d uptime math.
// Grows slowly — ~30 rows/service/month.
model StatusPeriod {
  id         BigInt        @id @default(autoincrement())
  service_id String
  status     String // "up" | "down" | "degraded"
  started_at DateTime
  ended_at   DateTime? // null = ongoing
  service    StatusService @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id, started_at])
}

// Incidents (degradations + scheduled maintenance). Even external-only
// incidents from statuspage feeds are mirrored here so we own the data.
model Incident {
  id          String           @id @default(cuid())
  service_id  String?
  external_id String? // dedupe key per source (UptimeRobot alert id, statuspage incident id, ...)
  source      String // "manual" | "uptimerobot-webhook" | "statuspage-feed"
  severity    String // "minor" | "major" | "critical" | "maintenance"
  status      String // "investigating" | "identified" | "monitoring" | "resolved"
  title_it    String
  title_en    String
  body_it     String           @db.Text
  body_en     String           @db.Text
  started_at  DateTime
  resolved_at DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  service     StatusService?   @relation(fields: [service_id], references: [id], onDelete: SetNull)
  updates     IncidentUpdate[]

  @@unique([source, external_id])
  @@index([status, started_at])
  @@index([service_id])
}

// Per-incident timeline entries (e.g. "Identified root cause at 14:32").
model IncidentUpdate {
  id          String   @id @default(cuid())
  incident_id String
  status      String // mirrors Incident.status at the time of the update
  body_it     String   @db.Text
  body_en     String   @db.Text
  createdAt   DateTime @default(now())
  incident    Incident @relation(fields: [incident_id], references: [id], onDelete: Cascade)

  @@index([incident_id, createdAt])
}
