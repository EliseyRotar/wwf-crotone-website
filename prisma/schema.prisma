generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin / manager accounts. Role superadmin = you (creator), sees everything.
// Role manager = Paolo or other local WWF managers, limited to their assigned turns.
model User {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String?
  passwordHash      String
  role              String       @default("manager") // "superadmin" | "manager"
  assignedTurns     String? // CSV of Turno.id for managers, null = all turns (superadmin)
  expiresAt         DateTime? // when the account expires (e.g. when the last assigned turn ends)
  active            Boolean      @default(true) // false = disabled
  totpSecret        String? // M4: TOTP secret for 2FA
  totpEnabled       Boolean      @default(false) // M4: 2FA enabled flag
  deletedAt         DateTime? // M1: soft delete timestamp
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  iscrizioniManaged Iscrizione[] @relation("ManagedBy")
}

// Weekly camp turns. The 12 turns for summer 2026 are seeded.
// capacity is the max volunteers per turn (configurable from admin).
model Turno {
  id              String            @id @default(cuid())
  number          Int               @unique // 1..12
  startDate       DateTime
  endDate         DateTime
  capacity        Int               @default(20)
  bookedCount     Int               @default(0) // C-07: atomic counter for capacity
  isActive        Boolean           @default(true)
  iscrizioni      Iscrizione[]
  iscrizioneTurni IscrizioneTurno[] // M5: junction for multi-week registrations
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([number])
}

// A registration. status is managed from admin panel.
// isMinor triggers the parent/guardian consent block.
model Iscrizione {
  id                   String            @id @default(cuid())
  // Personal
  firstName            String
  lastName             String
  birthDate            DateTime? // null when only age is known (imported from Excel)
  age                  Int? // used when birthDate is unknown; admin can add birthDate later
  email                String
  phone                String
  isMinor              Boolean
  // If minor
  guardianName         String?
  guardianEmail        String?
  guardianPhone        String?
  guardianConsent      Boolean           @default(false)
  // Turn — primary turn; multi-week registrations use the IscrizioneTurno junction
  turnoId              String
  turno                Turno             @relation(fields: [turnoId], references: [id])
  iscrizioneTurni      IscrizioneTurno[] // M5: junction for multi-week registrations
  // Health & diet
  allergies            String?
  medications          String?
  swimmingAbility      String? // "none" | "basic" | "confident"
  tetanusStatus        String? // "unknown" | "vaccinated" | "not_vaccinated"
  fitnessSelf          String?
  dietaryNeeds         String? // "none" | "vegetarian" | "vegan" | "celiac" | "other"
  dietaryNotes         String?
  tshirtSize           String? // "S" | "M" | "L" | "XL" | "XXL"
  // Logistics
  arrivalMode          String? // "own_car" | "train" | "bus" | "plane_crotone" | "plane_lamezia" | "need_pickup"
  arrivalTime          String? // e.g. "14:30"
  departureTime        String? // e.g. "10:00"
  // Admin-managed
  status               String            @default("pending") // "pending" | "confirmed" | "paid" | "cancelled" | "waitlist"
  // Payment tracking — split into registration fee (100€) + balance
  feePaid              Boolean           @default(false) // 100€ registration fee paid
  feePaidDate          DateTime?
  balancePaid          Boolean           @default(false) // remaining balance paid
  balancePaidDate      DateTime?
  paymentIntentId      String? // M6: external payment intent reference (e.g. Stripe)
  notes                String? // internal admin notes (length validated at app level)
  // Phase 2: receipt tracking — set on volunteer self-service upload,
  // approved by admin from /admin/iscrizioni.
  depositReceiptUrl         String?
  balanceReceiptUrl         String?
  depositReceiptUploadedAt  DateTime?
  balanceReceiptUploadedAt  DateTime?
  depositReceiptApprovedAt  DateTime?
  balanceReceiptApprovedAt  DateTime?
  // Consent
  privacyConsent       Boolean           @default(false)
  marketingConsent     Boolean           @default(false)
  imageDataConsent     Boolean           @default(false)
  // Meta
  deletedAt            DateTime? // M1: soft delete timestamp
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  managedBy            String? // User.id who last changed status
  manager              User?             @relation("ManagedBy", fields: [managedBy], references: [id])
  receipts             Receipt[]
  payments             Payment[] // M6: payment history
  // Personal-user area (Phase 1): when set, the volunteer cannot edit their
  // personal/contact fields via /account/profile. Logistics fields remain
  // editable until the camp starts.
  personalDataLockedAt DateTime?

  @@index([turnoId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([turnoId, status])
  @@index([managedBy])
}

// M5: Junction table for multi-week registrations.
// isPrimary flags the main turn on the Iscrizione row.
model IscrizioneTurno {
  id           String     @id @default(cuid())
  iscrizioneId String
  iscrizione   Iscrizione @relation(fields: [iscrizioneId], references: [id], onDelete: Cascade)
  turnoId      String
  turno        Turno      @relation(fields: [turnoId], references: [id])
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([iscrizioneId, turnoId])
  @@index([turnoId])
}

model GalleryItem {
  id         String    @id @default(cuid())
  type       String // "image" | "video"
  src        String // path or youtube id
  thumbnail  String? // for video, poster
  titleIt    String
  titleEn    String?
  captionIt  String?
  captionEn  String?
  category   String // "tartarughe" | "cleanup" | "wildlife" | "campo" | "schiuse" | "cultura"
  year       Int       @default(2026)
  uploaderId String? // User.id
  deletedAt  DateTime? // M1: soft delete timestamp
  createdAt  DateTime  @default(now())

  @@index([category])
  @@index([year])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("it")
  consent        Boolean   @default(false)
  consentedAt    DateTime?
  consentIp      String?
  consentUa      String?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Camp operators / staff (distinct from volunteer registrations).
// role: "operatore" | "tecnico" | "coordinatore"
model Operatore {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  sex           String? // "M" | "F"
  role          String    @default("operatore") // "operatore" | "tecnico" | "coordinatore"
  email         String?
  phone         String?
  // CSV of Turno.id — which turns the operator is assigned to
  assignedTurns String?
  notes         String?
  deletedAt     DateTime? // M1: soft delete timestamp
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([role])
}

// M3: In-progress draft registrations saved between wizard steps.
model DraftIscrizione {
  id        String   @id @default(cuid())
  email     String
  data      String // JSON blob
  step      Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
}

// Receipt/bonifico uploaded by the volunteer
model Receipt {
  id           String     @id @default(cuid())
  iscrizioneId String
  iscrizione   Iscrizione @relation(fields: [iscrizioneId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  mimeType     String
  uploadedAt   DateTime   @default(now())

  @@index([iscrizioneId])
}

// M6: Payment history. One Iscrizione can have multiple Payments
// (deposit + balance + future Stripe intents).
model Payment {
  id           String     @id @default(cuid())
  iscrizioneId String
  iscrizione   Iscrizione @relation(fields: [iscrizioneId], references: [id], onDelete: Cascade)
  amountCents  Int
  currency     String     @default("EUR")
  provider     String // "stripe" | "bank_transfer" | "cash"
  status       String     @default("pending") // "pending" | "completed" | "failed" | "refunded"
  externalId   String? // Stripe payment intent id
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([iscrizioneId])
  @@index([status])
}

// Blog / news posts
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleIt     String
  titleEn     String?
  contentIt   String
  contentEn   String?
  excerptIt   String?
  excerptEn   String?
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  deletedAt   DateTime? // M1: soft delete timestamp
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([published])
  @@index([published, publishedAt])
}

// Audit log for admin actions
// Phase 1: extended to support per-field changes — `fieldName`, `oldValue`,
// `newValue`, plus request context (ipAddress, userAgent). Older rows
// without these columns are still valid (the columns are nullable).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // "create" | "update" | "delete" | "status_change" | "payment" | "login" | "field_change"
  entity    String // "iscrizione" | "turno" | "operatore" | "user" | "gallery" | "blog" | "settings"
  entityId  String?
  details   String? // JSON or human-readable description
  fieldName String? // Phase 1: which field changed (for per-field audit)
  oldValue  String? // Phase 1: previous value (stringified; null = was null)
  newValue  String? // Phase 1: new value (stringified; null = became null)
  ipAddress String? // Phase 1: caller IP (truncated)
  userAgent String? // Phase 1: caller UA (truncated to 256 chars at write)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@index([entityId])
}

// Camp settings — year, dates, number of turns (for recurring camp config)
model CampSettings {
  id               String   @id @default(cuid())
  year             Int      @default(2026)
  startDate        DateTime
  endDate          DateTime
  numTurns         Int      @default(12)
  turnDurationDays Int      @default(7)
  costNonMember    Int      @default(430)
  costMember       Int      @default(400)
  minorInsurance   Int      @default(20)
  registrationFee  Int      @default(100)
  iban             String   @default("IT30V0306909606100000107334")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
}

// Phase 1: one-time magic links emailed to volunteers for passwordless login
// to /account. We store only the SHA-256 hash of the token (not the token
// itself) so a DB leak does not let the attacker log in as any user. Tokens
// are single-use (consumedAt) and expire in 30 minutes.
model MagicLink {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

// Phase 1: "remember this device" cookie. We persist a row per (user,
// device) so we can revoke a device, list active devices, and audit the
// last-seen IP/UA. The cookie itself is an HMAC-signed payload bound to
// the row's deviceHash + expiresAt — see src/lib/deviceSession.ts.
model DeviceSession {
  id         String   @id @default(cuid())
  userId     String // Iscrizione.id of the volunteer this device is logged in as
  deviceHash String // HMAC of UA + accept-language + a server secret
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@unique([userId, deviceHash])
  @@index([expiresAt])
}

// Phase 2: lightweight admin notifications (e.g. "volunteer X uploaded a
// receipt", "volunteer Y edited their booking"). Linked to admin User.id
// — not the volunteer's Iscrizione.id — so the admin bell can list
// pending items per admin. The admin panel can mark them read (readAt).
model Notification {
  id        String    @id @default(cuid())
  userId    String // admin User.id (who should see this)
  type      String // "booking_edit" | "receipt_upload" | ...
  title     String
  body      String
  link      String? // e.g. /admin/iscrizioni/[id]
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}
