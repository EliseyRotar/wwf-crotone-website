# Production env — copy to /srv/wwf/.env.production on the VPS, chmod 600.
# Every variable here must be set before docker compose up.

# ─── Database ────────────────────────────────────────────────────
POSTGRES_PASSWORD=                # openssl rand -base64 32

# ─── Auth ────────────────────────────────────────────────────────
AUTH_SECRET=                       # openssl rand -base64 48

# ─── URLs ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://wwfcrotone.it
NEXT_PUBLIC_VERGARI_URL=https://www.riservanaturaledelvergari.it/

# ─── AI chatbot (Groq free tier) ────────────────────────────────
GROQ_API_KEY=                      # https://console.groq.com/keys

# ─── Transactional email (Brevo free tier) ─────────────────────
USE_BREVO_EMAIL=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=                          # your Brevo login email
SMTP_PASS=                          # SMTP key (NOT account password)
ADMIN_NOTIFY_EMAIL=wwfcrotone26@gmail.com

# Gmail fallback — only used if USE_BREVO_EMAIL=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=wwfcrotone26@gmail.com
# SMTP_PASS=                         # Gmail app password

# ─── Rate limit (optional, free tier) ────────────────────────────
UPSTASH_REDIS_REST_URL=             # https://console.upstash.com
UPSTASH_REDIS_REST_TOKEN=

# ─── Error tracking (Sentry Developer free tier) ─────────────────
SENTRY_DSN=                         # https://sentry.io → Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=             # for client-side error capture

# ─── Analytics (Plausible, privacy-first, no consent needed) ─────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=wwfcrotone.it

# ─── Cloudflare trusted proxy ────────────────────────────────────
TRUSTED_PROXY_HEADER=cf-connecting-ip

# ─── Maintenance mode (set to "true" during deploy cutovers) ─────
MAINTENANCE_MODE=false

# ─── Backups (WAL-G → Cloudflare R2) ─────────────────────────────
WALG_S3_PREFIX=s3://wwf-backups
AWS_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_ACCESS_KEY_ID=                  # R2 access key
AWS_SECRET_ACCESS_KEY=              # R2 secret key
WALG_COMPRESSION_METHOD=lz4

# ─── R2: Gallery (public-read, custom domain gallery.wwfcrotone.it) ───
# The same AWS_* creds work for both buckets (they share the R2 account),
# but you can scope a separate token per bucket if you want hard isolation.
R2_GALLERY_BUCKET=wwf-gallery
R2_GALLERY_PUBLIC_BASE=https://gallery.wwfcrotone.it